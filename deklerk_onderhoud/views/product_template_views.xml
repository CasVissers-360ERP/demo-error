<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_maintenance" model="ir.ui.view">
        <field name="name">product.template.form.maintenance</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Onderhoudscontract" name="maintenance" invisible="type != 'service'">
                    <field name="maintenance_type"/>
                    <field name="visits_per_year" invisible="not maintenance_type"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
