<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_maintenance" model="ir.ui.view">
        <field name="name">sale.order.form.maintenance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='analytic_distribution']" position="after">
                <field name="maintenance_type" column_invisible="True"/>
                <field name="order_partner_commercial_id" column_invisible="True"/>
                <field name="maintenance_location_id" optional="show" invisible="not maintenance_type"
                       options="{'no_create': True}"/>
                <field name="visits_per_year" optional="show" invisible="not maintenance_type"/>
                <field name="norm_minutes_per_unit" optional="hide" invisible="not maintenance_type"/>
                <field name="norm_hours_per_visit" optional="show" invisible="not maintenance_type" widget="float_time"/>
                <field name="small_route" optional="hide" invisible="not maintenance_type"/>
                <field name="planning_note" optional="hide" invisible="not maintenance_type"/>
            </xpath>
        </field>
    </record>
</odoo>
