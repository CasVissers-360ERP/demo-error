<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_afroep" model="ir.ui.view">
        <field name="name">sale.order.form.afroep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="has_afroep_line" invisible="1" />
                <button
                    name="action_view_afroep_reservations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-lock"
                    invisible="not has_afroep_line"
                >
                    <field
                        name="afroep_reservation_count"
                        widget="statinfo"
                        string="Reservations"
                    />
                </button>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                position="after"
            >
                <field name="is_afroep_line" column_invisible="1" />
                <field
                    name="afroep_reserve_product_id"
                    string="Reserve Product"
                    optional="show"
                    readonly="not is_afroep_line"
                    required="is_afroep_line"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
