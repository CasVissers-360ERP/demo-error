<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="summit_season_view_list" model="ir.ui.view">
        <field name="name">summit.season.list</field>
        <field name="model">summit.season</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code" />
                <field name="name" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>
    <record id="summit_season_action" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">summit.season</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="summit_season_menu"
        name="Seasons"
        parent="sale.menu_sale_config"
        action="summit_season_action"
        sequence="30"
    />
</odoo>
