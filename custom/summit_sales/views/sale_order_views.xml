<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.summit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="summit_order_type" readonly="state == 'cancel' or locked" />
                <field name="summit_season_id" readonly="state == 'cancel' or locked" />
            </field>
        </field>
    </record>
    <record id="sale_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list.summit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="summit_order_type" optional="show" />
                <field name="summit_season_id" optional="show" />
            </field>
        </field>
    </record>
    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">sale.order.search.summit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="salesperson" position="after">
                <filter name="group_order_type" string="Order Type" context="{'group_by': 'summit_order_type'}" />
                <filter name="group_season" string="Season" context="{'group_by': 'summit_season_id'}" />
            </filter>
            <field name="user_id" position="after">
                <field name="summit_season_id" />
            </field>
        </field>
    </record>
</odoo>
