<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_payment_section" position="inside">
                <setting string="Invoice Payment" help="Allow registering payments for unpaid invoices from POS">
                    <field name="pos_enable_invoice_payment"/>
                    <div class="content-group mt16" invisible="not pos_enable_invoice_payment">
                        <div class="row">
                            <label string="Payment Journals" for="pos_invoice_payment_journal_ids" class="col-lg-3 o_light_label"/>
                            <field name="pos_invoice_payment_journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
