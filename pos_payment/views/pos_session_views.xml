<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_invoice_payment" model="ir.ui.view">
        <field name="name">pos.session.form.invoice.payment</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <!-- Add Invoice Payment button after Payments button -->
            <xpath expr="//button[@name='action_show_payments_list']" position="after">
                <button
                    name="action_view_invoice_payments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="invoice_payment_count == 0"
                    >
                    <field name="invoice_payment_count" widget="statinfo" string="Invoice Payments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
