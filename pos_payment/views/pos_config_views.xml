<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_invoice_payment" model="ir.ui.view">
        <field name="name">pos.config.form.invoice.payment</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Invoice Payment" help="Allow registering payments for unpaid invoices from POS">
                    <field name="enable_invoice_payment"/>
                    <div class="content-group mt16" invisible="not enable_invoice_payment">
                        <div class="row">
                            <label string="Payment Journals" for="invoice_payment_journal_ids" class="col-lg-3 o_light_label"/>
                            <field name="invoice_payment_journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
