<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- Hide Internal Note button from main button row -->
        <xpath expr="//OrderlineNoteButton[@label='internalNoteLabel()']" position="replace">
            <!-- Hidden - moved to Actions popup -->
        </xpath>
        
        <!-- Add Invoice button in main button row after Customer button -->
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!props.showRemainingButtons and pos.config.enable_invoice_payment" 
                    t-att-class="buttonClass" 
                    t-on-click="() => this.onClickInvoice()">
                <i class="fa fa-file-text-o me-1" role="img" aria-label="Invoice Payment" title="Invoice Payment" /> 
                Invoice
            </button>
        </xpath>
        
        <!-- Add Invoice button to Actions popup -->
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton[1]" position="before">
            <!-- <button t-if="pos.config.enable_invoice_payment" 
                    class="btn btn-secondary btn-lg py-5" 
                    t-on-click="() => this.onClickInvoice()">
                <i class="fa fa-file-text-o me-2" role="img" aria-label="Invoice Payment" title="Invoice Payment" /> 
                Invoice
            </button> -->
            <OrderlineNoteButton 
                label="internalNoteLabel()"
                getter="(orderline) => orderline.getNote()"
                class="buttonClass"
                setter="(orderline, note) => orderline.setNote(note)" />
        </xpath>
    </t>
</templates>
